{
  "problems": {
    "Rollout": {
      "description": "Error and metric paths are relative to a submission's metrics object; errors are always measured on the test set. overallMetrics selects the metric IDs shown beside the selected error.",
      "defaultCategory": "testRollout",
      "overallMetrics": ["parameters", "inferenceMs"],
      "categories": [
        {
          "id": "testRollout",
          "label": "Test rollout",
          "defaultError": "rmse",
          "errors": [
            { "id": "rmse", "label": "RMSE", "path": "rolloutRmse" },
            { "id": "mae", "label": "MAE", "path": "rolloutMae" },
            { "id": "relativeL2", "label": "Rel. L₂", "path": "rolloutRelativeL2" },
            { "id": "vrmse", "label": "VRMSE", "path": "statistics.vrmse" },
            { "id": "decorrelation", "label": "1 − ρ (correlation)", "path": "statistics.decorrelation" },
            { "id": "anomalyDecorrelation", "label": "1 − ACC (anomaly corr.)", "path": "statistics.anomalyDecorrelation" },
            { "id": "murphyPhase", "label": "MSE phase term", "path": "statistics.murphyPhase" },
            { "id": "energyError", "label": "Energy error", "path": "statistics.energyError" },
            { "id": "wasserstein", "label": "Wasserstein-1", "path": "statistics.wasserstein" },
            { "id": "settledRmse", "label": "Settled RMSE", "path": "settled.rolloutRmse" },
            { "id": "settledVrmse", "label": "Settled VRMSE", "path": "settled.vrmse" },
            { "id": "settledWasserstein", "label": "Settled Wasserstein-1", "path": "settled.wasserstein" },
            { "id": "podEnergyError", "label": "POD energy error", "path": "modal.podEnergyError" },
            { "id": "frequencyError", "label": "Frequency error", "path": "modal.frequencyError" }
          ]
        }
      ],
      "metrics": [
        { "id": "parameters", "label": "Params", "path": "efficiency.parameters", "format": "count" },
        { "id": "inferenceMs", "label": "Inference / sample", "path": "efficiency.inferenceMs", "format": "milliseconds" },
        { "id": "memoryGb", "label": "GPU memory", "path": "efficiency.memoryGb", "format": "gigabytes" }
      ]
    }
  }
}
